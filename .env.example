APP_NAME=RAG_env
app_version=0.1.0_env
DATABASE_URL=sqlite:///./app.db

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT 的安全性完全依赖 secret 保密,因为传的payload是base64编码的，就是明文
# 服务器验证签名的时候是 payload+secret 


# ===== M5 切块 =====
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_CHARS=30

# ===== M6 embedding =====
# hash = 离线确定性哈希，只有词面信息，**不是语义向量**（仅用于本地/CI 跑通管道）
# openai = 任意 OpenAI 兼容的 /embeddings 接口（智谱、DashScope、自建 vLLM 都行）
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://llm.ujn.edu.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
# hash 提供方必须显式给维度；openai 提供方以接口返回为准
EMBEDDING_DIM=256

# Qdrant：本地开发用嵌入式（path），生产用服务端（url，见 docker-compose.yml）
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_COLLECTION=chunks

# ===== M7 检索 =====
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

# ===== M8 问答 =====
LLM_BASE_URL=https://llm.ujn.edu.cn/v1
# 留空 → /api/v1/chat/ask 返回 mode=retrieval_only（只给检索结果，不伪造答案）
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

