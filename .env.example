# ---------- 应用 ----------
APP_NAME=RAG MVP
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./app.db

# ---------- JWT ----------
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 上传 ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ---------- 检索 / 切块 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ---------- Embedding ----------
# hash = 离线可用的哈希向量（默认，无需 key）
# openai = 任意 OpenAI 兼容 /embeddings 接口
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=256

# ---------- LLM ----------
# mock = 离线假模型（默认，无需 key，可完整跑通链路）
# openai = 任意 OpenAI 兼容 /chat/completions 接口（OpenAI / DeepSeek / Qwen / 本地 vLLM 等）
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# ---------- 天气 Tool ----------
# OPENWEATHER_API_KEY 为空时使用离线 mock 天气，保证 demo 可跑
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
